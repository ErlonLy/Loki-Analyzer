{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loki Analyzer",
  "version": "2.0.0",
  "identifier": "com.lokianalyzer.app",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loki Analyzer v2.0 - Anti-Cheat & Binary Forensics",
        "width": 1280,
        "height": 850,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
